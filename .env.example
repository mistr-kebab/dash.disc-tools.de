# Environment Variables

# --- Discord ---
DISCORD_CLIENT_ID=1508899864602345582
DISCORD_CLIENT_SECRET=your_client_secret_here
DISCORD_BOT_TOKEN=your_bot_token_here
APPLICATION_ID=1508899864602345582

# --- OAuth2 ---
REDIRECT_URI=https://dash.disc-tools.de/api/auth/callback
AUTH_REDIRECT_URI=https://dash.disc-tools.de/api/auth/callback

# --- Dashboard ---
JWT_SECRET=your_jwt_secret_here
IP_HASH_SALT=your_ip_hash_salt_here
PORT=3005
LOG_LEVEL=info

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=disc_tools
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Top.gg ---
TOPGG_API_KEY=your_topgg_api_key_here
TOPGG_WEBHOOK_SECRET=your_topgg_webhook_secret_here

# --- VPN Check (optional) ---
VPN_CHECK_API=https://vpn-check-api.example.com
VPN_WHITELIST=127.0.0.1,::1
